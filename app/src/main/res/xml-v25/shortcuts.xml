<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutId="shortcut_downloads"
        android:shortcutLongLabel="@string/shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads">
        <intent
            android:action="com.amaze.filemanager.openDownloads"
            android:targetClass="com.amaze.filemanager.ui.activities.MainActivity"
            android:targetPackage="app.fileosophy.files" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_home"
        android:shortcutId="shortcut_home"
        android:shortcutLongLabel="@string/home"
        android:shortcutShortLabel="@string/home">
        <intent
            android:action="com.amaze.filemanager.openHome"
            android:targetClass="com.amaze.filemanager.ui.activities.MainActivity"
            android:targetPackage="app.fileosophy.files" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
        android:shortcutId="shortcut_recent"
        android:shortcutLongLabel="@string/recent"
        android:shortcutShortLabel="@string/recent">
        <intent
            android:action="com.amaze.filemanager.openRecent"
            android:targetClass="com.amaze.filemanager.ui.activities.MainActivity"
            android:targetPackage="app.fileosophy.files" />
    </shortcut>

</shortcuts>